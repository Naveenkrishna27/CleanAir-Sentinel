# NASA POWER requires no API key.
# Required: your Earth Engine Cloud project ID. IMPORTANT — this must be a
# project that shows under "Earth Engine enabled Cloud Projects" at
# code.earthengine.google.com, NOT just any Cloud project you own. Check the
# project switcher in the Code Editor if you're unsure which one that is.
EE_PROJECT_ID=your_registered_ee_project_id
